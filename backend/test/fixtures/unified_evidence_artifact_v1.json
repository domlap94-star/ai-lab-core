{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "next-stabil://unified-evidence-artifact/v1",
  "title": "NEXT Stabil unified evidence artifact v1",
  "type": "object",
  "required": [
    "request_id", "scope", "facts", "estimates", "hypotheses", "missing",
    "contradictions", "tool_results", "visual_observations", "unresolved_questions"
  ],
  "properties": {
    "request_id": {"type": "string", "minLength": 1},
    "scope": {
      "type": "object",
      "properties": {"client_id": {"type": ["string", "null"]}},
      "required": ["client_id"],
      "additionalProperties": false
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim_id", "statement", "source_refs", "confidence"],
        "properties": {
          "claim_id": {"type": "string"},
          "statement": {"type": "string"},
          "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "confidence": {"enum": ["HIGH", "MEDIUM", "LOW"]}
        },
        "additionalProperties": false
      }
    },
    "estimates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim_id", "value_or_range", "confidence", "basis_refs", "assumptions", "missing_inputs"],
        "properties": {
          "claim_id": {"type": "string"},
          "value_or_range": {"type": "string"},
          "confidence": {"enum": ["HIGH", "MEDIUM", "LOW"]},
          "basis_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "assumptions": {"type": "array", "items": {"type": "string"}},
          "missing_inputs": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim_id", "statement", "support_refs", "contradiction_refs", "confirm_or_refute"],
        "properties": {
          "claim_id": {"type": "string"},
          "statement": {"type": "string"},
          "support_refs": {"type": "array", "items": {"type": "string"}},
          "contradiction_refs": {"type": "array", "items": {"type": "string"}},
          "confirm_or_refute": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "missing": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["item", "why_relevant", "estimable"],
        "properties": {
          "item": {"type": "string"},
          "why_relevant": {"type": "string"},
          "estimable": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "contradictions": {"type": "array", "items": {"type": "object"}},
    "tool_results": {"type": "array", "items": {"type": "object"}},
    "visual_observations": {"type": "array", "items": {"type": "object"}},
    "unresolved_questions": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
