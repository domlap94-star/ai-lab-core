@dataclass(frozen=True)
class DocumentMetadataResult:
    status: str
    raw_metadata: dict[str, Any] | None
    normalized_metadata: dict[str, Any] | None
    error: str | None = None


class DocumentMetadataService:
    IMAGE_EXTENSIONS = {
        ".jpg",
        ".jpeg",
        ".png",
        ".tif",
        ".tiff",
        ".heic",
        ".heif",
        ".webp",
        ".bmp",
    }

    IMAGE_CONTENT_TYPES = {
        "image/jpeg",
        "image/jpg",
        "image/png",
        "image/tiff",
        "image/heic",
        "image/heif",
        "image/webp",
        "image/bmp",
    }

    def extract(
        self,
        *,
        path: Path,
        content_type: str | None,
        original_filename: str | None,
    ) -> DocumentMetadataResult:
        if not path.exists():
            return DocumentMetadataResult(
                status="failed",
                raw_metadata=None,
                normalized_metadata=None,
                error=f"File does not exist: {path}",
            )

        normalized_content_type = (
            content_type or ""
        ).strip().lower()

        extension = Path(
            original_filename or path.name
        ).suffix.lower()

        try:
            if (
                normalized_content_type == "application/pdf"
                or extension == ".pdf"
            ):
                return self._extract_pdf(path)

            if extension == ".docx":
                return self._extract_docx(path)

            if extension == ".xlsx":
                return self._extract_xlsx(path)

            if extension == ".pptx":
                return self._extract_pptx(path)

            if extension in {
                ".odt",
                ".ods",
                ".odp",
            }:
                return self._extract_odf(path)

            if (
                normalized_content_type
                in self.IMAGE_CONTENT_TYPES
                or extension in self.IMAGE_EXTENSIONS
            ):
                return self._extract_image(path)

            return DocumentMetadataResult(
                status="unsupported",
                raw_metadata=None,
                normalized_metadata=None,
                error=None,
            )

        except Exception as error:
            return DocumentMetadataResult(
                status="failed",
                raw_metadata=None,
                normalized_metadata=None,
                error=str(error),
            )

    def _extract_pdf(
        self,
        path: Path,
    ) -> DocumentMetadataResult:
        pdf = fitz.open(str(path))

        try:
            raw = dict(pdf.metadata or {})

            raw["page_count"] = len(pdf)
            raw["is_pdf"] = pdf.is_pdf
            raw["is_encrypted"] = pdf.is_encrypted
            raw["is_repaired"] = pdf.is_repaired

            raw["pdf_version"] = getattr(
                pdf,
                "pdf_version",
                None,
            )

            normalized = {
                "format": "pdf",
                "title": self._clean(
                    raw.get("title")
                ),
                "subject": self._clean(
                    raw.get("subject")
                ),
                "author": self._clean(
                    raw.get("author")
                ),
                "keywords": self._clean(
                    raw.get("keywords")
                ),
                "creator": self._clean(
                    raw.get("creator")
                ),
                "producer": self._clean(
                    raw.get("producer")
                ),
                "created_at": self._normalize_pdf_date(
                    raw.get("creationDate")
                ),
                "modified_at": self._normalize_pdf_date(
                    raw.get("modDate")
                ),
                "page_count": len(pdf),
                "is_encrypted": bool(
                    pdf.is_encrypted
                ),
                "is_repaired": bool(
                    pdf.is_repaired
                ),
                "pdf_format": self._clean(
                    raw.get("format")
                ),
            }

            return DocumentMetadataResult(
                status="processed",
                raw_metadata=self._json_safe(raw),
                normalized_metadata=self._json_safe(
                    normalized
                ),
                error=None,
            )

        finally:
            pdf.close()

    def _extract_docx(
        self,
        path: Path,
    ) -> DocumentMetadataResult:
        document = DocxDocument(
            str(path)
        )

        properties = document.core_properties

        raw = {
            "title": properties.title,
            "subject": properties.subject,
            "author": properties.author,
            "last_modified_by": (
                properties.last_modified_by
            ),
            "keywords": properties.keywords,
            "comments": properties.comments,
            "category": properties.category,
            "identifier": properties.identifier,
            "language": properties.language,
            "version": properties.version,
            "revision": properties.revision,
            "created": properties.created,
            "modified": properties.modified,
            "last_printed": properties.last_printed,
        }

        normalized = {
            "format": "docx",
            "title": self._clean(
                properties.title
            ),
            "subject": self._clean(
                properties.subject
            ),
            "author": self._clean(
                properties.author
            ),
            "last_modified_by": self._clean(
                properties.last_modified_by
            ),
            "keywords": self._clean(
                properties.keywords
            ),
            "created_at": self._datetime_iso(
                properties.created
            ),
            "modified_at": self._datetime_iso(
                properties.modified
            ),
            "revision": (
                int(properties.revision)
                if properties.revision is not None
                else None
            ),
        }

        return DocumentMetadataResult(
            status="processed",
            raw_metadata=self._json_safe(raw),
            normalized_metadata=self._json_safe(
                normalized
            ),
            error=None,
        )

    def _extract_xlsx(
        self,
        path: Path,
    ) -> DocumentMetadataResult:
        workbook = load_workbook(
            filename=str(path),
            read_only=True,
            data_only=False,
        )

        try:
            properties = workbook.properties

            sheet_names = list(
                workbook.sheetnames
            )

            raw = {
                "title": properties.title,
                "subject": properties.subject,
                "creator": properties.creator,
                "last_modified_by": (
                    properties.lastModifiedBy
                ),
                "keywords": properties.keywords,
                "description": properties.description,
                "category": properties.category,
                "identifier": properties.identifier,
                "language": properties.language,
                "version": properties.version,
                "created": properties.created,
                "modified": properties.modified,
                "revision": properties.revision,
                "sheet_names": sheet_names,
                "sheet_count": len(sheet_names),
            }

            normalized = {
                "format": "xlsx",
                "title": self._clean(
                    properties.title
                ),
                "subject": self._clean(
                    properties.subject
                ),
                "author": self._clean(
                    properties.creator
                ),
                "last_modified_by": self._clean(
                    properties.lastModifiedBy
                ),
                "keywords": self._clean(
                    properties.keywords
                ),
                "created_at": self._datetime_iso(
                    properties.created
                ),
                "modified_at": self._datetime_iso(
                    properties.modified
                ),
                "sheet_names": sheet_names,
                "sheet_count": len(
                    sheet_names
                ),
            }

            return DocumentMetadataResult(
                status="processed",
                raw_metadata=self._json_safe(
                    raw
                ),
                normalized_metadata=self._json_safe(
                    normalized
                ),
                error=None,
            )

        finally:
            workbook.close()

