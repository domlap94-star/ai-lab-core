{
  "name": "AI Lab Global Mail Send Adapter",
  "active": false,
  "settings": {"executionOrder": "v1"},
  "meta": {
    "templateOnly": true,
    "activationGate": "FOLLOWUP_EMAIL_SEND_TEST_TARGET_REQUIRED",
    "credentialPolicy": "Bind the existing gmailOAuth2 credential and a dedicated native Header Auth credential in n8n; never export either secret."
  },
  "nodes": [
    {
      "name": "Internal Mail Send Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "webhookId": "09d9d44d-5cf0-4d15-b15e-d6458ab168ef",
      "position": [0, 0],
      "parameters": {"httpMethod": "POST", "path": "ai-lab-global-mail-send-v1", "authentication": "headerAuth", "responseMode": "responseNode"},
      "credentials": {"httpHeaderAuth": {"id": "BIND_MAIL_SEND_SECRET_CREDENTIAL", "name": "AI Lab Mail Send Webhook Secret"}}
    },
    {
      "name": "Validate Bounded Contract",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [240, 0],
      "parameters": {
        "jsCode": "const p=$json.body||{}; if(!['compose','reply','forward'].includes(p.action)) throw new Error('invalid_action'); if(!p.operation_id||!Array.isArray(p.to)||typeof p.body!=='string'||p.body.length>100000) throw new Error('invalid_contract'); const binary={}; for(const [i,a] of (p.attachments||[]).entries()){ if(!a.content_base64||!a.filename||!a.mime_type) throw new Error('invalid_attachment'); binary['attachment_'+i]={data:a.content_base64,fileName:a.filename,mimeType:a.mime_type}; } p.attachment_fields=Object.keys(binary).join(','); p.has_attachments=Object.keys(binary).length>0; return [{json:p,binary}];"
      }
    },
    {
      "name": "Route Allowed Action",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [480, 0],
      "parameters": {
        "rules": {"values": [
          {"conditions": {"conditions": [{"leftValue": "={{ $json.action }}", "rightValue": "compose", "operator": {"type": "string", "operation": "equals"}}, {"leftValue": "={{ $json.has_attachments }}", "rightValue": false, "operator": {"type": "boolean", "operation": "equals"}}]}},
          {"conditions": {"conditions": [{"leftValue": "={{ $json.action }}", "rightValue": "reply", "operator": {"type": "string", "operation": "equals"}}, {"leftValue": "={{ $json.has_attachments }}", "rightValue": false, "operator": {"type": "boolean", "operation": "equals"}}]}},
          {"conditions": {"conditions": [{"leftValue": "={{ $json.action }}", "rightValue": "forward", "operator": {"type": "string", "operation": "equals"}}, {"leftValue": "={{ $json.has_attachments }}", "rightValue": false, "operator": {"type": "boolean", "operation": "equals"}}]}},
          {"conditions": {"conditions": [{"leftValue": "={{ $json.action }}", "rightValue": "compose", "operator": {"type": "string", "operation": "equals"}}, {"leftValue": "={{ $json.has_attachments }}", "rightValue": true, "operator": {"type": "boolean", "operation": "equals"}}]}},
          {"conditions": {"conditions": [{"leftValue": "={{ $json.action }}", "rightValue": "reply", "operator": {"type": "string", "operation": "equals"}}, {"leftValue": "={{ $json.has_attachments }}", "rightValue": true, "operator": {"type": "boolean", "operation": "equals"}}]}},
          {"conditions": {"conditions": [{"leftValue": "={{ $json.action }}", "rightValue": "forward", "operator": {"type": "string", "operation": "equals"}}, {"leftValue": "={{ $json.has_attachments }}", "rightValue": true, "operator": {"type": "boolean", "operation": "equals"}}]}}
        ]}
      }
    },
    {
      "name": "Gmail Compose",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [740, -160],
      "parameters": {"resource": "message", "operation": "send", "sendTo": "={{ $json.to.join(',') }}", "subject": "={{ $json.subject }}", "emailType": "text", "message": "={{ $json.body }}", "options": {"ccList": "={{ ($json.cc||[]).join(',') }}", "bccList": "={{ ($json.bcc||[]).join(',') }}"}},
      "credentials": {"gmailOAuth2": {"id": "BIND_EXISTING_CREDENTIAL", "name": "BIND EXISTING GMAIL OAUTH2"}}
    },
    {
      "name": "Gmail Reply",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [740, 0],
      "parameters": {"resource": "message", "operation": "reply", "messageId": "={{ $json.source_provider_message_id }}", "emailType": "text", "message": "={{ $json.body }}"},
      "credentials": {"gmailOAuth2": {"id": "BIND_EXISTING_CREDENTIAL", "name": "BIND EXISTING GMAIL OAUTH2"}}
    },
    {
      "name": "Gmail Forward",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [740, 160],
      "parameters": {"resource": "message", "operation": "send", "sendTo": "={{ $json.to.join(',') }}", "subject": "={{ $json.subject }}", "emailType": "text", "message": "={{ $json.body }}", "options": {"ccList": "={{ ($json.cc||[]).join(',') }}", "bccList": "={{ ($json.bcc||[]).join(',') }}"}},
      "credentials": {"gmailOAuth2": {"id": "BIND_EXISTING_CREDENTIAL", "name": "BIND EXISTING GMAIL OAUTH2"}}
    },
    {
      "name": "Gmail Compose With Attachments",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [740, 320],
      "parameters": {"resource": "message", "operation": "send", "sendTo": "={{ $json.to.join(',') }}", "subject": "={{ $json.subject }}", "emailType": "text", "message": "={{ $json.body }}", "options": {"ccList": "={{ ($json.cc||[]).join(',') }}", "bccList": "={{ ($json.bcc||[]).join(',') }}", "attachmentsUi": {"attachmentsBinary": [{"property": "={{ $json.attachment_fields }}"}]}}},
      "credentials": {"gmailOAuth2": {"id": "BIND_EXISTING_CREDENTIAL", "name": "BIND EXISTING GMAIL OAUTH2"}}
    },
    {
      "name": "Gmail Reply With Attachments",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [740, 480],
      "parameters": {"resource": "message", "operation": "reply", "messageId": "={{ $json.source_provider_message_id }}", "emailType": "text", "message": "={{ $json.body }}", "options": {"attachmentsUi": {"attachmentsBinary": [{"property": "={{ $json.attachment_fields }}"}]}}},
      "credentials": {"gmailOAuth2": {"id": "BIND_EXISTING_CREDENTIAL", "name": "BIND EXISTING GMAIL OAUTH2"}}
    },
    {
      "name": "Gmail Forward With Attachments",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [740, 640],
      "parameters": {"resource": "message", "operation": "send", "sendTo": "={{ $json.to.join(',') }}", "subject": "={{ $json.subject }}", "emailType": "text", "message": "={{ $json.body }}", "options": {"ccList": "={{ ($json.cc||[]).join(',') }}", "bccList": "={{ ($json.bcc||[]).join(',') }}", "attachmentsUi": {"attachmentsBinary": [{"property": "={{ $json.attachment_fields }}"}]}}},
      "credentials": {"gmailOAuth2": {"id": "BIND_EXISTING_CREDENTIAL", "name": "BIND EXISTING GMAIL OAUTH2"}}
    },
    {
      "name": "Provider Accepted Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [1000, 0],
      "parameters": {"respondWith": "json", "responseBody": "={{ {accepted:true,provider_message_id:$json.id,provider_thread_id:$json.threadId||null,provider_execution_ref:$execution.id} }}"}
    }
  ],
  "connections": {
    "Internal Mail Send Webhook": {"main": [[{"node": "Validate Bounded Contract", "type": "main", "index": 0}]]},
    "Validate Bounded Contract": {"main": [[{"node": "Route Allowed Action", "type": "main", "index": 0}]]},
    "Route Allowed Action": {"main": [
      [{"node": "Gmail Compose", "type": "main", "index": 0}],
      [{"node": "Gmail Reply", "type": "main", "index": 0}],
      [{"node": "Gmail Forward", "type": "main", "index": 0}],
      [{"node": "Gmail Compose With Attachments", "type": "main", "index": 0}],
      [{"node": "Gmail Reply With Attachments", "type": "main", "index": 0}],
      [{"node": "Gmail Forward With Attachments", "type": "main", "index": 0}]
    ]},
    "Gmail Compose": {"main": [[{"node": "Provider Accepted Response", "type": "main", "index": 0}]]},
    "Gmail Reply": {"main": [[{"node": "Provider Accepted Response", "type": "main", "index": 0}]]},
    "Gmail Forward": {"main": [[{"node": "Provider Accepted Response", "type": "main", "index": 0}]]},
    "Gmail Compose With Attachments": {"main": [[{"node": "Provider Accepted Response", "type": "main", "index": 0}]]},
    "Gmail Reply With Attachments": {"main": [[{"node": "Provider Accepted Response", "type": "main", "index": 0}]]},
    "Gmail Forward With Attachments": {"main": [[{"node": "Provider Accepted Response", "type": "main", "index": 0}]]}
  }
}
